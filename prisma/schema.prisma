// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

// NextAuth.js Models
// https://next-auth.js.org/adapters/models

model Account {
    id                       String  @id @default(cuid())
    userId                   String
    type                     String
    provider                 String
    providerAccountId        String
    refresh_token            String? @db.Text
    access_token             String? @db.Text
    expires_at               Int?
    token_type               String?
    scope                    String?
    id_token                 String? @db.Text
    session_state            String?
    user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    refresh_token_expires_in Int?

    @@unique([provider, providerAccountId])
}

model Session {
    id           String   @id @default(cuid())
    sessionToken String   @unique
    userId       String
    expires      DateTime
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
    identifier String
    token      String   @unique
    expires    DateTime

    @@unique([identifier, token])
}

// Application Models

model User {
    id            String    @id @default(cuid())
    name          String?
    email         String?   @unique
    emailVerified DateTime?
    image         String?
    bio           String?   @db.Text
    website       String?
    twitter       String?
    totalPoints   Int       @default(0)
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt

    accounts         Account[]
    sessions         Session[]
    memberships      Membership[]
    posts            Post[]
    reactions        Reaction[]
    questSubmissions QuestSubmission[]
    createdGuilds    Guild[]           @relation("GuildCreator")
    createdQuests    Quest[]           @relation("QuestCreator")
}

enum MemberRole {
    ADMIN
    ELDER
    MEMBER
}

model Guild {
    id          String   @id @default(cuid())
    name        String
    slug        String   @unique
    description String?  @db.Text
    image       String?
    inviteCode  String   @unique @default(cuid())
    isPublic    Boolean  @default(false)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
    creatorId   String

    creator     User         @relation("GuildCreator", fields: [creatorId], references: [id])
    memberships Membership[]
    channels    Channel[]
    quests      Quest[]
    posts       Post[]       @relation("GuildPosts")

    @@index([slug])
    @@index([inviteCode])
}

model Membership {
    id        String     @id @default(cuid())
    role      MemberRole @default(MEMBER)
    joinedAt  DateTime   @default(now())
    points    Int        @default(0)
    userId    String
    guildId   String
    // カスタムロールバッジ
    badges    String[]   @default([])
    // 自己紹介カード用フィールド
    intro     String?    @db.Text
    expertise String[]   @default([])

    user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
    guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

    @@unique([userId, guildId])
    @@index([guildId])
    @@index([userId])
}

model Channel {
    id          String   @id @default(cuid())
    name        String
    slug        String
    description String?  @db.Text
    isPrivate   Boolean  @default(false)
    position    Int      @default(0)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
    guildId     String

    guild   Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
    threads Thread[]

    @@unique([guildId, slug])
    @@index([guildId])
}

model Thread {
    id        String   @id @default(cuid())
    title     String
    slug      String
    isPinned  Boolean  @default(false)
    isLocked  Boolean  @default(false)
    viewCount Int      @default(0)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    channelId String

    channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
    posts   Post[]

    @@unique([channelId, slug])
    @@index([channelId])
    @@index([isPinned])
}

model Post {
    id        String   @id @default(cuid())
    content   String   @db.Text
    isPinned  Boolean  @default(false)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    authorId  String
    threadId  String?
    guildId   String?
    // AI生成のハイライト投稿かどうか
    isAiHighlight Boolean @default(false)

    author    User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
    thread    Thread?    @relation(fields: [threadId], references: [id], onDelete: Cascade)
    guild     Guild?     @relation("GuildPosts", fields: [guildId], references: [id], onDelete: Cascade)
    reactions Reaction[]

    @@index([authorId])
    @@index([threadId])
    @@index([guildId])
    @@index([isPinned])
    @@index([createdAt])
}

enum ReactionType {
    LIKE
    LOVE
    INSIGHTFUL
    ROCKET
    EYES
}

model Reaction {
    id        String       @id @default(cuid())
    type      ReactionType
    createdAt DateTime     @default(now())
    userId    String
    postId    String

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
    post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

    @@unique([userId, postId, type])
    @@index([postId])
    @@index([userId])
}

enum QuestStatus {
    DRAFT
    ACTIVE
    COMPLETED
    ARCHIVED
}

model Quest {
    id          String      @id @default(cuid())
    title       String
    description String      @db.Text
    points      Int         @default(0)
    status      QuestStatus @default(DRAFT)
    deadline    DateTime?
    createdAt   DateTime    @default(now())
    updatedAt   DateTime    @updatedAt
    guildId     String
    creatorId   String

    guild       Guild             @relation(fields: [guildId], references: [id], onDelete: Cascade)
    creator     User              @relation("QuestCreator", fields: [creatorId], references: [id])
    submissions QuestSubmission[]

    @@index([guildId])
    @@index([status])
    @@index([deadline])
}

enum SubmissionStatus {
    PENDING
    APPROVED
    REJECTED
    NEEDS_REVISION
}

model QuestSubmission {
    id          String           @id @default(cuid())
    content     String           @db.Text
    status      SubmissionStatus @default(PENDING)
    feedback    String?          @db.Text
    pointsAwarded Int?
    submittedAt DateTime         @default(now())
    reviewedAt  DateTime?
    userId      String
    questId     String

    user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
    quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)

    @@unique([userId, questId])
    @@index([questId])
    @@index([userId])
    @@index([status])
}
