// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

// Seed configuration
// Run: npm run db:seed

// NextAuth.js Models
// https://next-auth.js.org/adapters/models

model Account {
    id                       String  @id @default(cuid())
    userId                   String
    type                     String
    provider                 String
    providerAccountId        String
    refresh_token            String? @db.Text
    access_token             String? @db.Text
    expires_at               Int?
    token_type               String?
    scope                    String?
    id_token                 String? @db.Text
    session_state            String?
    user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    refresh_token_expires_in Int?

    @@unique([provider, providerAccountId])
}

model Session {
    id           String   @id @default(cuid())
    sessionToken String   @unique
    userId       String
    expires      DateTime
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
    identifier String
    token      String   @unique
    expires    DateTime

    @@unique([identifier, token])
}

// Application Models

model User {
    id            String    @id @default(cuid())
    name          String?
    email         String?   @unique
    emailVerified DateTime?
    image         String?
    bio           String?   @db.Text
    website       String?
    twitter       String?
    totalPoints   Int       @default(0)
    // PHASE 3: User preferences (notification settings, UI prefs, etc.)
    preferences   Json?
    // PHASE 3: Last activity timestamp
    lastActiveAt  DateTime?
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt

    accounts          Account[]
    sessions          Session[]
    memberships       Membership[]
    posts             Post[]
    reactions         Reaction[]
    questSubmissions  QuestSubmission[]
    createdGuilds     Guild[]           @relation("GuildCreator")
    createdQuests     Quest[]           @relation("QuestCreator")
    // PHASE 3: New relations
    notifications     Notification[]
    activities        Activity[]
    sentNotifications Notification[]    @relation("NotificationActor")
}

enum MemberRole {
    ADMIN
    ELDER
    MEMBER
}

model Guild {
    id          String   @id @default(cuid())
    name        String
    slug        String   @unique
    description String?  @db.Text
    image       String?
    inviteCode  String   @unique @default(cuid())
    isPublic    Boolean  @default(false)
    // PHASE 3: Guild settings (theme, enabled features, custom fields, etc.)
    settings    Json?
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
    creatorId   String

    creator      User           @relation("GuildCreator", fields: [creatorId], references: [id])
    memberships  Membership[]
    channels     Channel[]
    quests       Quest[]
    posts        Post[]         @relation("GuildPosts")
    // PHASE 3: New relations
    activities   Activity[]
    integrations Integration[]
    metrics      GuildMetric[]

    @@index([slug])
    @@index([inviteCode])
}

model Membership {
    id        String     @id @default(cuid())
    role      MemberRole @default(MEMBER)
    joinedAt  DateTime   @default(now())
    points    Int        @default(0)
    userId    String
    guildId   String
    // カスタムロールバッジ
    badges    String[]   @default([])
    // 自己紹介カード用フィールド
    intro     String?    @db.Text
    expertise String[]   @default([])
    // PHASE 3: Activity tracking
    lastActiveAt DateTime?

    user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
    guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

    @@unique([userId, guildId])
    @@index([guildId])
    @@index([userId])
    @@index([lastActiveAt])
}

model Channel {
    id          String   @id @default(cuid())
    name        String
    slug        String
    description String?  @db.Text
    isPrivate   Boolean  @default(false)
    position    Int      @default(0)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
    guildId     String

    guild   Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
    threads Thread[]

    @@unique([guildId, slug])
    @@index([guildId])
}

model Thread {
    id        String   @id @default(cuid())
    title     String
    slug      String
    isPinned  Boolean  @default(false)
    isLocked  Boolean  @default(false)
    viewCount Int      @default(0)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    channelId String

    channel     Channel       @relation(fields: [channelId], references: [id], onDelete: Cascade)
    posts       Post[]
    // PHASE 3: Tagging support
    tagRelations TagRelation[]

    @@unique([channelId, slug])
    @@index([channelId])
    @@index([isPinned])
}

model Post {
    id        String   @id @default(cuid())
    content   String   @db.Text
    isPinned  Boolean  @default(false)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    authorId  String
    threadId  String?
    guildId   String?
    // AI生成のハイライト投稿かどうか
    isAiHighlight Boolean @default(false)
    // PHASE 3: Rich content metadata (polls, attachments, embeds, etc.)
    metadata  Json?

    author       User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
    thread       Thread?       @relation(fields: [threadId], references: [id], onDelete: Cascade)
    guild        Guild?        @relation("GuildPosts", fields: [guildId], references: [id], onDelete: Cascade)
    reactions    Reaction[]
    // PHASE 3: Tagging support
    tagRelations TagRelation[]

    @@index([authorId])
    @@index([threadId])
    @@index([guildId])
    @@index([isPinned])
    @@index([createdAt])
}

enum ReactionType {
    LIKE
    LOVE
    INSIGHTFUL
    ROCKET
    EYES
}

model Reaction {
    id        String       @id @default(cuid())
    type      ReactionType
    createdAt DateTime     @default(now())
    userId    String
    postId    String

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)
    post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

    @@unique([userId, postId, type])
    @@index([postId])
    @@index([userId])
}

enum QuestStatus {
    DRAFT
    ACTIVE
    COMPLETED
    ARCHIVED
}

model Quest {
    id          String      @id @default(cuid())
    title       String
    description String      @db.Text
    points      Int         @default(0)
    status      QuestStatus @default(DRAFT)
    deadline    DateTime?
    // PHASE 3: Quest templates for reuse
    isTemplate  Boolean     @default(false)
    createdAt   DateTime    @default(now())
    updatedAt   DateTime    @updatedAt
    guildId     String
    creatorId   String

    guild        Guild             @relation(fields: [guildId], references: [id], onDelete: Cascade)
    creator      User              @relation("QuestCreator", fields: [creatorId], references: [id])
    submissions  QuestSubmission[]
    // PHASE 3: Tagging support
    tagRelations TagRelation[]

    @@index([guildId])
    @@index([status])
    @@index([deadline])
    @@index([isTemplate])
}

enum SubmissionStatus {
    PENDING
    APPROVED
    REJECTED
    NEEDS_REVISION
}

model QuestSubmission {
    id            String           @id @default(cuid())
    content       String           @db.Text
    status        SubmissionStatus @default(PENDING)
    feedback      String?          @db.Text
    pointsAwarded Int?
    submittedAt   DateTime         @default(now())
    reviewedAt    DateTime?
    userId        String
    questId       String

    user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
    quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)

    @@unique([userId, questId])
    @@index([questId])
    @@index([userId])
    @@index([status])
}

// ============================================================================
// PHASE 3: NEW ENTITIES
// ============================================================================

enum NotificationType {
    MENTION
    REPLY
    REACTION
    QUEST_ASSIGNED
    QUEST_APPROVED
    QUEST_REJECTED
    MEMBER_JOINED
    SYSTEM_ALERT
}

model Notification {
    id        String           @id @default(cuid())
    type      NotificationType
    title     String
    message   String           @db.Text
    isRead    Boolean          @default(false)
    // Link to relevant resource (post, quest, etc.)
    resourceType String?
    resourceId   String?
    // Contextual data
    data      Json?
    createdAt DateTime         @default(now())
    // Recipient
    userId    String
    // Actor who triggered the notification (optional)
    actorId   String?

    user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
    actor User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

    @@index([userId, isRead])
    @@index([createdAt])
}

enum ActivityType {
    GUILD_CREATED
    GUILD_JOINED
    POST_CREATED
    THREAD_CREATED
    QUEST_CREATED
    QUEST_SUBMITTED
    QUEST_COMPLETED
    REACTION_ADDED
    MEMBER_PROMOTED
}

model Activity {
    id           String       @id @default(cuid())
    type         ActivityType
    description  String
    // Link to relevant resource
    resourceType String?
    resourceId   String?
    // Contextual data
    metadata     Json?
    createdAt    DateTime     @default(now())
    // Actor (the user who performed the action)
    userId       String
    // Guild context (if applicable)
    guildId      String?

    user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
    guild Guild? @relation(fields: [guildId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([guildId])
    @@index([createdAt])
    @@index([type])
}

model Tag {
    id          String   @id @default(cuid())
    name        String
    slug        String   @unique
    description String?
    color       String?  @default("#6366f1")
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    tagRelations TagRelation[]

    @@index([slug])
}

model TagRelation {
    id           String   @id @default(cuid())
    tagId        String
    // Polymorphic relation
    resourceType String // "post", "thread", "quest"
    resourceId   String
    createdAt    DateTime @default(now())

    tag    Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)
    post   Post?   @relation(fields: [resourceId], references: [id], onDelete: Cascade)
    thread Thread? @relation(fields: [resourceId], references: [id], onDelete: Cascade)
    quest  Quest?  @relation(fields: [resourceId], references: [id], onDelete: Cascade)

    @@unique([tagId, resourceType, resourceId])
    @@index([resourceType, resourceId])
    @@index([tagId])
}

enum IntegrationType {
    DISCORD_WEBHOOK
    SLACK_WEBHOOK
    ZAPIER
    CUSTOM_WEBHOOK
}

model Integration {
    id            String          @id @default(cuid())
    type          IntegrationType
    name          String
    isEnabled     Boolean         @default(true)
    // Integration-specific config (webhook URL, API keys, etc.)
    config        Json
    // Event filters (which events trigger this integration)
    eventFilters  String[]        @default([])
    createdAt     DateTime        @default(now())
    updatedAt     DateTime        @updatedAt
    guildId       String

    guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

    @@index([guildId])
    @@index([isEnabled])
}

model GuildMetric {
    id                 String   @id @default(cuid())
    date               DateTime @db.Date
    // Member metrics
    totalMembers       Int      @default(0)
    activeMembers      Int      @default(0)
    newMembers         Int      @default(0)
    // Content metrics
    postsCreated       Int      @default(0)
    threadsCreated     Int      @default(0)
    reactionsGiven     Int      @default(0)
    // Quest metrics
    questsCompleted    Int      @default(0)
    questsCreated      Int      @default(0)
    pointsAwarded      Int      @default(0)
    // Engagement score (0-100)
    engagementScore    Float    @default(0)
    // Additional metadata
    metadata           Json?
    guildId            String

    guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

    @@unique([guildId, date])
    @@index([guildId])
    @@index([date])
}
